+.r-special .face-frame:before{content:"";position:absolute;inset:-1px;border-radius:inherit;
+ pointer-events:none;box-shadow:inset clamp(-2px,calc(var(--gift-edge,0) * 3px),2px) 0 0 #fff4faff,
